/* Model, tokenizer, golden file (and kernel test vectors for int8 kernels) embedded in
 * the firmware image.
 * .flashdata stays in flash even in copy_to_ram builds, so the weights are read
 * through the XIP cache exactly like the ESP32 reads its mmapped partition.
 * Generated by CMake from blobs.S.in; paths come from PLE_MODEL_DIR. */

    .section .flashdata.ple_model, "a"
    .balign 4096
    .global ple_model_start, ple_model_end
ple_model_start:
    .incbin "@PLE_MODEL_DIR_ABS@/model.bin"
ple_model_end:

    .section .flashdata.ple_tok, "a"
    .balign 4
    .global ple_tok_start, ple_tok_end
ple_tok_start:
    .incbin "@PLE_MODEL_DIR_ABS@/tokenizer.bin"
ple_tok_end:

    .section .flashdata.ple_golden, "a"
    .global ple_golden_start
ple_golden_start:
    .incbin "@PLE_MODEL_DIR_ABS@/@PLE_GOLDEN@"
    .byte 0

#if PLE_KERNEL_I8
    .section .flashdata.ple_kvec, "a"
    .balign 16
    .global ple_kvec_start, ple_kvec_end
ple_kvec_start:
    .incbin "@PLE_MODEL_DIR_ABS@/kvec.bin"
ple_kvec_end:
#endif
